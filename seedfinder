#!/usr/bin/env bash
# Alloy Seed Finder, development launcher (no arguments opens the app). Uses the Minecraft jars from the
# Fabric Loom cache instead of the first-run download. To build the shareable zip, use ./build.sh.: sets up lib/ from your Minecraft 1.21.11 files (first run only), compiles, runs.
set -euo pipefail
DIR="$(cd "$(dirname "$0")" && pwd)"
JAVA_HOME="${JAVA_HOME:-$HOME/.local/share/PrismLauncher/java/java-runtime-delta}"
LOOM="$HOME/.gradle/caches/fabric-loom"
LIB="$DIR/lib"
OUT="$DIR/build"

if [ ! -f "$LIB/.ready" ]; then
  echo "First run: copying Minecraft 1.21.11 files into lib/ ..."
  mkdir -p "$LIB"
  mc=$(ls "$LOOM"/minecraftMaven/net/minecraft/minecraft-common/1.21.11-loom.mappings.*/minecraft-common-1.21.11-loom.mappings.*.jar 2>/dev/null | grep -v sources | head -1 || true)
  if [ -z "$mc" ] || [ ! -f "$LOOM/1.21.11/minecraft-server.jar" ]; then
    echo "Can't find the Minecraft 1.21.11 jars in $LOOM. Build any of your 1.21.11 mods once, then try again." >&2
    exit 1
  fi
  cp "$mc" "$LIB/minecraft-1.21.11.jar"
  tmp=$(mktemp -d)
  unzip -q -o "$LOOM/1.21.11/minecraft-server.jar" 'META-INF/libraries/*' -d "$tmp"
  find "$tmp" -name '*.jar' -exec cp {} "$LIB" \;
  rm -rf "$tmp"
  touch "$LIB/.ready"
fi

mapfile -t SRC < <(find "$DIR/src" -name "*.java")
# The first-run converter libraries (only needed to compile the launcher; Minecraft comes from lib/ here).
G="$HOME/.gradle/caches/modules-2/files-2.1"
DEPS="$(ls "$G"/net.fabricmc/tiny-remapper/0.14.1/*/tiny-remapper-0.14.1.jar "$G"/net.fabricmc/mapping-io/0.8.0/*/mapping-io-0.8.0.jar | tr '\n' ':')"
if [ ! -f "$OUT/.built" ] || [ -n "$(find "$DIR/src" "$DIR/src-ffm" -name '*.java' -newer "$OUT/.built")" ]; then
  rm -rf "$OUT" && mkdir -p "$OUT"
  "$JAVA_HOME/bin/javac" -nowarn -d "$OUT" -cp "$LIB/*:$DEPS" "${SRC[@]}"
  # The graphics card code (src-ffm), once per Java: a Java 21 preview build, and a Java 22+ build if there's a newer JDK.
  GPU_TMP=$(mktemp -d)
  mkdir -p "$GPU_TMP/21/dev/steelaspect/seedfinder/gpu/ffm21"
  for f in "$DIR"/src-ffm/dev/steelaspect/seedfinder/gpu/ffm/*.java; do
    sed 's/^package dev.steelaspect.seedfinder.gpu.ffm;/package dev.steelaspect.seedfinder.gpu.ffm21;/' "$f" > "$GPU_TMP/21/dev/steelaspect/seedfinder/gpu/ffm21/$(basename "$f")"
  done
  "$JAVA_HOME/bin/javac" -nowarn -XDsuppressNotes --release 21 --enable-preview -d "$OUT" -cp "$OUT" "$GPU_TMP"/21/dev/steelaspect/seedfinder/gpu/ffm21/*.java
  JDK22=$(for j in /usr/lib/jvm/*/bin/javac; do v=$("$j" -version 2>&1 | grep -oP '\d+' | head -1); [ "${v:-0}" -ge 22 ] && echo "$j" && break; done || true)
  if [ -n "$JDK22" ]; then
    mkdir -p "$GPU_TMP/22/dev/steelaspect/seedfinder/gpu/ffm22"
    for f in "$DIR"/src-ffm/dev/steelaspect/seedfinder/gpu/ffm/*.java; do
      sed 's/^package dev.steelaspect.seedfinder.gpu.ffm;/package dev.steelaspect.seedfinder.gpu.ffm22;/' "$f" > "$GPU_TMP/22/dev/steelaspect/seedfinder/gpu/ffm22/$(basename "$f")"
    done
    "$JDK22" -nowarn --release 22 -d "$OUT" -cp "$OUT" "$GPU_TMP"/22/dev/steelaspect/seedfinder/gpu/ffm22/*.java
  fi
  rm -rf "$GPU_TMP"
  cp "$DIR"/resources/* "$OUT/"
  touch "$OUT/.built"
fi

# Mesa's OpenCL (rusticl) only offers 64-bit maths when asked; the graphics card code needs it.
case ",${RUSTICL_FEATURES:-}," in *,fp64,*) ;; *) export RUSTICL_FEATURES="${RUSTICL_FEATURES:+$RUSTICL_FEATURES,}fp64" ;; esac
exec "$JAVA_HOME/bin/java" --enable-preview --enable-native-access=ALL-UNNAMED -Xmx${SEEDFINDER_XMX:-8G} -cp "$OUT:$LIB/*" dev.steelaspect.seedfinder.Main "$@"
